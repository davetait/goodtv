<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV sources are commonly plain http. Allow cleartext app-wide for now;
     tighten to specific domains once a playlist source is configured. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
